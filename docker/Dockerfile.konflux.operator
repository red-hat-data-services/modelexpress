# ModelExpress operator (controller) image for RHEL/UBI9.
#
# Multi-stage build that compiles the operator from source on UBI9.
# Runtime stage uses ubi-minimal for a small footprint with microdnf
# available if additional packages are ever needed.
#
# Hermetic: every input is prefetched by Hermeto (cargo, rpm) per
# docker/konflux/operator/. Local build: ./docker/konflux/build-local.sh operator

FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:16e9e43d99e181463513cc84a514859b1abb9460f1c4d9e208da4b4e51cd5cc3 AS build

# openssl-devel: FIPS builds link RHEL's openssl (ci/check-fips-crypto.sh)
RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        rust cargo gcc binutils openssl-devel \
    && dnf clean all

WORKDIR /src
COPY . .
RUN cargo build --release --locked --package modelexpress-operator-openshift \
        --no-default-features --features openssl \
    && ci/check-fips-crypto.sh target/release/modelexpress-operator-openshift \
    && cp target/release/modelexpress-operator-openshift /modelexpress-operator

FROM registry.redhat.io/ubi9/ubi-minimal-pqc:9.8-1791946957@sha256:b3a0b012de0c578082e1bc5b01c8bc27461b4eeb571a0b1a2b21a07dbd845a62

RUN microdnf install -y --nodocs ca-certificates openssl-libs \
    && microdnf clean all

COPY --from=build --chmod=0555 /modelexpress-operator /usr/local/bin/modelexpress-operator

LABEL com.redhat.component="odh-modelexpress-operator-container" \
      description="Kubernetes operator for ModelExpress model routing" \
      summary="Kubernetes operator for ModelExpress model routing" \
      name="odh-modelexpress-operator-rhel9" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="8080:http" \
      io.k8s.display-name="odh-modelexpress-operator" \
      io.k8s.description="odh-modelexpress-operator" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/modelexpress-operator"]
